# URL pública do site. Obrigatória na produção da Vercel.
# Em desenvolvimento local, o fallback é http://localhost:3000.
SITE_URL=

# Só libera indexação quando o valor textual for exatamente true
# e VERCEL_ENV for production. Qualquer outro valor permanece bloqueado.
ALLOW_INDEXING=false

# Entrega de leads. Somente servidor; nunca usar prefixo NEXT_PUBLIC_.
# Aceita apenas disabled ou resend. Desenvolvimento local permanece disabled.
CONTACT_PROVIDER=disabled

# Obrigatórias somente quando CONTACT_PROVIDER=resend.
# Deixe vazio neste arquivo. Configure valores reais só nos escopos da Vercel:
# Development, Preview e Production, com destinatários distintos.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
