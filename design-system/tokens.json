{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "AZ Work Center Design Tokens",
    "version": "1.0.0",
    "status": "provisional-pending-logo-color-extraction"
  },
  "color": {
    "primitive": {
      "red": {
        "500": { "$value": "#EF233C", "$type": "color" },
        "600": { "$value": "#E21D2F", "$type": "color" },
        "700": { "$value": "#C9182B", "$type": "color" }
      },
      "neutral": {
        "0": { "$value": "#FFFFFF", "$type": "color" },
        "50": { "$value": "#F4F1EB", "$type": "color" },
        "400": { "$value": "#A9B0BA", "$type": "color" },
        "700": { "$value": "#2B3038", "$type": "color" },
        "800": { "$value": "#1A1D22", "$type": "color" },
        "900": { "$value": "#111317", "$type": "color" },
        "950": { "$value": "#090A0C", "$type": "color" }
      },
      "green": { "600": { "$value": "#2F9E62", "$type": "color" } },
      "amber": { "600": { "$value": "#D97706", "$type": "color" } },
      "blue": { "600": { "$value": "#2563EB", "$type": "color" } },
      "danger": { "600": { "$value": "#D9363E", "$type": "color" } }
    },
    "semantic": {
      "background": { "$value": "{color.primitive.neutral.50}", "$type": "color" },
      "foreground": { "$value": "{color.primitive.neutral.900}", "$type": "color" },
      "surface": { "$value": "{color.primitive.neutral.0}", "$type": "color" },
      "surfaceDark": { "$value": "{color.primitive.neutral.900}", "$type": "color" },
      "foregroundDark": { "$value": "{color.primitive.neutral.50}", "$type": "color" },
      "mutedForeground": { "$value": "{color.primitive.neutral.400}", "$type": "color" },
      "border": { "$value": "{color.primitive.neutral.700}", "$type": "color" },
      "primary": { "$value": "{color.primitive.red.600}", "$type": "color" },
      "primaryHover": { "$value": "{color.primitive.red.700}", "$type": "color" },
      "primaryForeground": { "$value": "{color.primitive.neutral.0}", "$type": "color" },
      "accentOnDark": { "$value": "{color.primitive.red.500}", "$type": "color" },
      "focus": { "$value": "{color.primitive.red.500}", "$type": "color" },
      "success": { "$value": "{color.primitive.green.600}", "$type": "color" },
      "warning": { "$value": "{color.primitive.amber.600}", "$type": "color" },
      "error": { "$value": "{color.primitive.danger.600}", "$type": "color" },
      "info": { "$value": "{color.primitive.blue.600}", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "Manrope, sans-serif", "$type": "fontFamily" },
      "editorial": { "$value": "Newsreader, serif", "$type": "fontFamily" },
      "mono": { "$value": "IBM Plex Mono, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    }
  },
  "space": {
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "5": { "$value": "1.25rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" },
    "10": { "$value": "2.5rem", "$type": "dimension" },
    "12": { "$value": "3rem", "$type": "dimension" },
    "16": { "$value": "4rem", "$type": "dimension" },
    "20": { "$value": "5rem", "$type": "dimension" },
    "24": { "$value": "6rem", "$type": "dimension" },
    "32": { "$value": "8rem", "$type": "dimension" },
    "40": { "$value": "10rem", "$type": "dimension" }
  },
  "radius": {
    "xs": { "$value": "0.25rem", "$type": "dimension" },
    "sm": { "$value": "0.5rem", "$type": "dimension" },
    "md": { "$value": "0.75rem", "$type": "dimension" },
    "lg": { "$value": "1.25rem", "$type": "dimension" },
    "pill": { "$value": "999rem", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": "80ms", "$type": "duration" },
      "fast": { "$value": "160ms", "$type": "duration" },
      "base": { "$value": "240ms", "$type": "duration" },
      "slow": { "$value": "420ms", "$type": "duration" },
      "deliberate": { "$value": "650ms", "$type": "duration" },
      "narrative": { "$value": "900ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": [0.22, 1, 0.36, 1], "$type": "cubicBezier" },
      "emphasized": { "$value": [0.16, 1, 0.3, 1], "$type": "cubicBezier" },
      "exit": { "$value": [0.4, 0, 1, 1], "$type": "cubicBezier" },
      "linear": { "$value": [0, 0, 1, 1], "$type": "cubicBezier" }
    }
  },
  "layout": {
    "container": { "$value": "80rem", "$type": "dimension" },
    "content": { "$value": "47.5rem", "$type": "dimension" },
    "text": { "$value": "42rem", "$type": "dimension" },
    "touchTarget": { "$value": "2.75rem", "$type": "dimension" }
  }
}

